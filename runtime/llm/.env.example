# Copy to .env and fill in. .env is gitignored and MUST NEVER be committed.
# This file contains NAMES ONLY — never paste a real key into .env.example.

# ---- LLM provider (choose one) -------------------------------------------
# Anthropic is the configured provider in config.yaml.
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com

# ---- LiteLLM proxy --------------------------------------------------------
# Clients authenticate to the proxy with this, not with the provider key.
# The provider key never leaves the proxy process.
LITELLM_MASTER_KEY=sk-local-dev-change-me

# ---- Langfuse -------------------------------------------------------------
# Cloud (recommended for a low-spec machine): https://cloud.langfuse.com
#   LANGFUSE_HOST=https://cloud.langfuse.com
# Self-hosted (6 containers, ~4 GB RAM — see docker-compose.langfuse.yml):
#   LANGFUSE_HOST=http://localhost:3000
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
